# 07 - 重定向 < > >>（mandatory）

## R01 | > 覆盖写入
rm -f out
echo hello > out
cat out

## R02 | >> 追加写入
rm -f out
echo 1 > out
echo 2 >> out
cat out

## R03 | < 输入重定向
rm -f in
printf "line1\nline2\n" > in
cat < in

## R04 | 多个输出重定向：以最后一个为准（out1 创建但内容在 out2）
rm -f out1 out2
echo hi > out1 > out2
printf "out1:["; cat out1; echo "]"
printf "out2:["; cat out2; echo "]"

## R05 | 重定向到只读文件：应 Permission denied
rm -f ro
echo x > ro
chmod -w ro
echo y > ro
echo $?
